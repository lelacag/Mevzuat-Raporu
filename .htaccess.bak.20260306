# ========================================
# alias redirects for Turkish login/register canonical paths
RedirectMatch 301 ^login\.php$ /giris
RedirectMatch 301 ^register\.php$ /kayit

# Clean URL routing (only apply when rewrite engine available)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # prevent directory listing
    Options -Indexes

    # canonical redirects for the old PHP filenames (login/register)
    RewriteCond %{THE_REQUEST} \s+/login\.php[\s?] [NC]
    RewriteRule ^login\.php$ /giris? [R=301,L]
    RewriteCond %{THE_REQUEST} \s+/register\.php[\s?] [NC]
    RewriteRule ^register\.php$ /kayit? [R=301,L]

    # canonical legacy query-URL redirects
    RewriteCond %{THE_REQUEST} \s+/profile\.php\?username=([^\s&]+) [NC]
    RewriteRule ^profile\.php$ /%1? [R=301,L]

    RewriteCond %{THE_REQUEST} \s+/post\.php\?id=([0-9]+) [NC]
    RewriteRule ^post\.php$ /post/%1? [R=301,L]

    # gzip sitemap when available
    <IfModule mod_mime.c>
        AddType application/xml .xml.gz
        AddEncoding gzip .gz
    </IfModule>
    <IfModule mod_headers.c>
        Header append Vary Accept-Encoding
    </IfModule>

    RewriteCond %{HTTP:Accept-Encoding} gzip
    RewriteCond %{DOCUMENT_ROOT}/sitemap_cache/sitemap.xml.gz -f
    RewriteRule ^sitemap\.xml$ /sitemap_cache/sitemap.xml.gz [L]
    RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]

    # RSS / Atom
    RewriteRule ^rss\.xml$ rss.php [L,QSA]
    RewriteRule ^atom\.xml$ atom.php [L,QSA]
    RewriteRule ^user/([^/]+)/rss\.xml$ user_rss.php?username=$1 [L,QSA]
    RewriteRule ^g/([^/]+)/rss\.xml$ group_rss.php?slug=$1 [L,QSA]
    RewriteCond %{REQUEST_URI} !^/(admin|api|assets|includes|lang|migrations|docs|templates|tests|QA)/ [NC]
    RewriteRule ^([^/]+)/rss\.xml$ user_rss.php?username=$1 [L,QSA]
    RewriteRule ^robots\.txt$ robots.php [L,QSA]

    # clean URL mappings
    RewriteRule ^anasayfa$ index.php [L,QSA]
    RewriteRule ^giris$ login.php [L,QSA]
    RewriteRule ^kayit$ register.php [L,QSA]
    # Clean URL for notification page (Turkish: bildirimler)
    # support optional filter segment: mention, comment, like, group, follow
    RewriteRule ^bildirimler(?:/(mention|comment|like|group|follow))?/?$ notification.php?filter=$1 [L,QSA]
    RewriteRule ^premium$ premium.php [L,QSA]
    RewriteRule ^etkinlikler$ events.php [L,QSA]
    RewriteRule ^ara$ search.php [L,QSA]
    RewriteRule ^kurallar$ rules.php [L,QSA]
    RewriteRule ^topluluklar/?$ groups.php [L,QSA]
    RewriteRule ^davet-et$ invite.php [L,QSA]

    RewriteRule ^/?$ index.php [L,QSA]
    # dynamic fallbacks (profiles/posts must come last)
    RewriteRule ^post/([0-9]+)$ post.php?id=$1 [L,QSA]
    RewriteRule ^([^/.]+)$ profile.php?username=$1 [L,QSA]
</IfModule>


DirectoryIndex index.php
ErrorDocument 500 /index.php
FallbackResource /index.php

# redirect reserved keywords to their real scripts before PHP routing
