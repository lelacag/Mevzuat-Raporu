.form-group label { display:block; margin-bottom:5px; font-weight:600; color:#555; }
.form-group input[type="text"], .form-group input[type="datetime-local"], .form-group textarea { width:100%; padding:10px; border:1px solid #ddd; border-radius:4px; font-size:14px; }
.form-group textarea { resize:vertical; }
</style>
<?php endif; ?>

