# ========================================
# .htaccess — mevzuatraporu.com
# Phase B Pass 3: Routing moved to PHP front controller (dispatch.php)
# 301 redirects, security headers, file access control, env vars remain here.
# ========================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ── Prevent directory listing ──────────────────────
    Options -Indexes

    # ── Serve captcha directly (skip all rewrites) ──────
    RewriteRule ^captcha_image\.php - [L]

    # ══════════════════════════════════════════════════════
    # 301 REDIRECTS — legacy .php → clean Turkish URLs
    # (Must stay in .htaccess: need THE_REQUEST matching)
    # ══════════════════════════════════════════════════════
    RewriteCond %{THE_REQUEST} \s+/login\.php[\s?] [NC]
    RewriteRule ^login\.php$ /giris? [R=301,L]

    RewriteCond %{THE_REQUEST} \s+/register\.php[\s?] [NC]
    RewriteCond %{QUERY_STRING} ^invite=([^&]+) [NC]
    RewriteRule ^register\.php$ /kayit/%1? [R=301,L]

    RewriteCond %{THE_REQUEST} \s+/register\.php[\s?] [NC]
    RewriteRule ^register\.php$ /kayit? [R=301,L]

    RewriteCond %{THE_REQUEST} \s+/logout\.php[\s?] [NC]
    RewriteRule ^logout\.php$ /cikis? [R=301,L]

    RewriteCond %{THE_REQUEST} \s+/post\.php\?id=([0-9]+) [NC]
    RewriteRule ^post\.php$ /post/%1? [R=301,L]

    RewriteRule ^privacy\.php$        /gizlilik     [R=301,L]
    RewriteRule ^kvkk\.php$           /kvkk         [R=301,L]
    RewriteRule ^cookie-policy\.php$  /cerezler     [R=301,L]

    # Redirect legacy tahlil editor URLs
    RewriteCond %{THE_REQUEST} \s/+test_advanced_poll\.php\?edit=([0-9]+)\s [NC]
    RewriteRule ^test_advanced_poll\.php$ /tahlil/duzenle/%1? [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+test_advanced_poll\.php\s [NC]
    RewriteRule ^test_advanced_poll\.php$ /tahlil/olustur? [R=301,L]

    # Redirect profil/password_change.php to clean URL
    RewriteRule ^profil/password_change\.php$ /profil/sifre-degistir [R=301,L]

    # Legacy encoded username paths (e.g. %20, %C4%B1)
    RewriteCond %{THE_REQUEST} \s/([^?]*%[0-9A-Fa-f]{2}[^?]*) [NC]
    RewriteCond %{REQUEST_URI} !^/(admin|api|assets|includes|lang|migrations|docs|templates|tests|QA)/ [NC]
    RewriteRule ^([^/]+)$ /profile.php?username=%1 [R=302,L,NE]

    # ══════════════════════════════════════════════════════
    # SITEMAP — gzip optimization
    # ══════════════════════════════════════════════════════
    <IfModule mod_mime.c>
        AddType application/xml .xml.gz
        AddEncoding gzip .gz
    </IfModule>
    RewriteCond %{HTTP:Accept-Encoding} gzip
    RewriteCond %{DOCUMENT_ROOT}/sitemap_cache/sitemap.xml.gz -f
    RewriteRule ^sitemap\.xml$ /sitemap_cache/sitemap.xml.gz [L]

    # ══════════════════════════════════════════════════════
    # DIRECTORY ACCESS CONTROL (before front controller)
    # ══════════════════════════════════════════════════════
    # Block non-public directories (403 Forbidden)
    RewriteRule ^(?:logs|migrations|vendor|templates|includes|src|modules|proto|ci)(?:/.*)?$ - [F,L]

    # Bypass directories with their own routing (passthrough)
    RewriteRule ^(admin|api|webhook|binder|apps)(/.*)?$ - [L]

    # ══════════════════════════════════════════════════════
    # FRONT CONTROLLER — route everything else to dispatch.php
    # ══════════════════════════════════════════════════════
    # Skip static asset files
    RewriteCond %{REQUEST_URI} \.(css|jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot|map)$
    RewriteRule ^ - [L]

    # Skip dispatch.php itself (prevent loop)
    RewriteRule ^dispatch\.php$ - [L]

    # Route all other requests through the front controller
    RewriteRule ^(.*)$ dispatch.php [QSA,L]
</IfModule>

# ========================================
# Security Headers
# ========================================
<IfModule mod_headers.c>
    Header set Content-Security-Policy "default-src 'self'; script-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'self'"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "0"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
    Header set Cross-Origin-Opener-Policy "same-origin"
    Header set Cross-Origin-Resource-Policy "same-origin"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    Header append Vary Accept-Encoding
</IfModule>

# ========================================
# File Access Control
# ========================================

# Block direct browser loading of CSS files in assets unless referred from same site
SetEnvIfNoCase Referer "^https?://([^.]+\.)?mevzuatraporu\.com/" css_allowed
<FilesMatch "\.(css)$">
    Require env css_allowed
</FilesMatch>

# Block JS/JSON (site operates without client-side JavaScript)
<FilesMatch "\.(json|js)$">
    Require all denied
</FilesMatch>

# Block sensitive file types from web access
<FilesMatch "\.(sql|md|sh|log|bak|env|ini|xml\.gz|txt|tmp|dist)$">
    Require all denied
</FilesMatch>

# Block dotfiles / git config / hidden sensitive names
<FilesMatch "^(\.|\.git|\.env)">
    Require all denied
</FilesMatch>

# Allow robots.txt and sitemap.xml through
<Files "robots.txt">
    Require all granted
</Files>
<Files "sitemap.xml">
    Require all granted
</Files>

# Restrict health.php to localhost only
<Files "health.php">
    Require ip 127.0.0.1 ::1
</Files>

# ========================================
# Environment Variables
# ========================================
SetEnv IAP_API_TOKEN "d5c01ec84a14915b25095f89c413108b19df6bebe259589e"
SetEnv ADMIN_API_TOKEN "27d27a456898c010f596fe270f0c0e6386d74c9f50577fdb"
SetEnv IAP_TEST_MODE "0"
SetEnv APP_ENV "production"
