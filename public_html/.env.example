APP_ENV=development
USE_CLEAN_URLS=1

DB_HOST=127.0.0.1
DB_NAME=your_database_name
DB_USER=your_db_user
DB_PASS=your_db_password

SMTP_HOST=smtp.example.com
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
MAIL_ENABLED=false

URL_SESSION_SECRET=replace_with_random_secret
APP_ENC_KEY=replace_with_random_base64_key
APP_SIGN_KEY=replace_with_random_base64_key
APP_ED25519_PRIVATE_KEY_BASE64=replace_with_valid_ed25519_private_key
APP_ED25519_PUBLIC_KEY_BASE64=replace_with_valid_ed25519_public_key

IAP_API_TOKEN=replace_with_token
ADMIN_API_TOKEN=replace_with_token
IAP_TEST_MODE=0

SITE_URL=http://localhost
